msgstr "المقارنة التباينية %1$s - %2$s"

msgid "Insufficient data to estimate full model/contrasts. Likely empty cells in between-subjects design (i.e., bad data structure)"
msgstr ""
"البيانات غير كافية لتقدير النموذج الكامل/المقارنات التباينية. يُرجَّح وجود خلايا "
"فارغة في التصميم بين الأفراد (أي بنية بيانات غير ملائمة)"

msgid "Please specify an additional contrast."
msgstr "يرجى تحديد مقارنة تباينية إضافية."

msgid "Wrong number of custom contrast matrix rows."
msgstr "عدد صفوف مصفوفة المقارنات التباينية المخصصة غير صحيح."

msgid "Please specify non-zero contrast weights."
msgstr "يرجى تحديد أوزان غير صفرية للمقارنة التباينية."

msgid "Post Hoc Tests"
msgstr "الاختبارات البعدية"

msgid "Standard (HSD)"
msgstr "قياسي (HSD)"

msgid "Standard"
msgstr "قياسي"

msgid "Results are averaged over the levels of: %s"
msgstr "تُحسب النتائج في المتوسط على مستويات: %s"

msgid "Some parameters were not estimable due to missingness."
msgstr "تعذر تقدير بعض المعلمات بسبب البيانات المفقودة."

msgid "Mean Difference and Cohen's d estimates"
msgstr "تقديرات فرق المتوسطات وحجم الأثر d لكوهين"

msgid "Mean Difference estimates"
msgstr "تقديرات فرق المتوسطين"

msgid "Bootstrapping based on %1$s replicates. %2$s are based on the median of the bootstrap distribution."
msgstr ""
"يستند البوتستراب إلى %1$s من التكرارات. وتستند %2$s إلى وسيط توزيع "
"البوتستراب."

msgid "Bias corrected accelerated."
msgstr "تصحيح التحيز والتسريع."

msgid "Bootstrapping Post Hoc Test"
msgstr "الاختبار البعدي بالبوتستراب"

msgid "Some confidence intervals could not be computed.\nPossibly too few bootstrap replicates."
msgstr ""
"تعذر حساب بعض فترات الثقة.\n"
"قد يكون عدد تكرارات البوتستراب قليلًا جدًا."

msgid "Games-Howell"
msgstr "غيمز–هاول"

msgid "Games-Howell Post Hoc Comparisons - %s"
msgstr "مقارنات غيمز–هاول البعدية - %s"

msgid "Comparison"
msgstr "المقارنة"

msgid "Mean Difference"
msgstr "فرق المتوسطين"

msgid "%.0f%% CI for Mean Difference"
msgstr "فترة ثقة %.0f%% لفرق المتوسطين"

msgid "p<sub>tukey</sub>"
msgstr "p<sub>tukey</sub>"

msgid "Results based on uncorrected means."
msgstr "تستند النتائج إلى متوسطات غير مصححة."

msgid "Dunnett"
msgstr "دانيت"

